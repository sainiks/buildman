# =============================================================================
# Buildman server configuration. Copy to .env.local (dev) or add these in your
# hosting provider's environment settings (production).
#
# None of these are *user* tokens. Your users never see or paste a token:
# they click "Connect" and approve access on GitHub / Vercel / Supabase.
# The values below are the app registrations YOU create once per service.
# =============================================================================

# --- Core -------------------------------------------------------------------
# Public URL of this deployment, no trailing slash. OAuth redirects and the
# tracking snippet are built from it. Use http://localhost:3000 in development.
APP_URL=http://localhost:3000

# Signs login cookies. At least 32 random characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Encrypts users' provider tokens at rest (AES-256-GCM). Exactly 32 random bytes,
# base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes every stored connection unreadable.
ENCRYPTION_KEY=

# --- Buildman's own database (a Supabase project dedicated to Buildman) ----------
# 1. Create a Supabase project. 2. Run supabase/schema.sql in its SQL editor.
# 3. Copy the project URL and the service_role key (server-only, never expose).
GITMAN_SUPABASE_URL=
GITMAN_SUPABASE_SERVICE_KEY=

# --- GitHub OAuth App (used for sign-in AND for creating repos) --------------
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: <APP_URL>/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Vercel Integration (lets users deploy to their own Vercel) ---------------
# Vercel -> Team Settings -> Integrations -> Developer -> Create
# Redirect URL: <APP_URL>/api/oauth/vercel/callback
# Slug is the last part of your integration's URL: vercel.com/integrations/<slug>
# Named VC_* on purpose: Vercel reserves every name that starts with VERCEL_.
VC_INTEGRATION_SLUG=
VC_CLIENT_ID=
VC_CLIENT_SECRET=

# --- Supabase OAuth App (lets users create databases in their own Supabase) ---
# Supabase -> Organization settings -> OAuth Apps -> Add application
# Redirect URI: <APP_URL>/api/oauth/supabase/callback
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# --- Netlify OAuth App (optional: lets users deploy to their own Netlify instead of Vercel) ---
# Netlify -> User settings -> Applications -> OAuth applications -> New
# Redirect URI: <APP_URL>/api/oauth/netlify/callback
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=

# Optional. Default region for databases created for users (ap-south-1 = Mumbai).
SUPABASE_REGION=ap-south-1
